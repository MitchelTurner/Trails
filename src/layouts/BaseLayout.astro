---
import "../styles/global.css";
import { site } from "../config/site";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
// The headline is the largest paint on most pages, so the display face is worth preloading.
import archivoWdth from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = site.name,
  description = site.description,
  canonical,
  image = "/og/default.png",
} = Astro.props;

const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const url = new URL(canonical ?? Astro.url.pathname, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || site.plausibleDomain;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  alternateName: site.orgName,
  url: site.url,
  email: site.email,
  description: site.description,
  areaServed: "Revillagigedo Island, Alaska",
  nonprofitStatus: "Informal unincorporated association",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#17211f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link
      rel="preload"
      href={archivoWdth}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} news`} href="/rss.xml" />
    <link rel="preconnect" href="https://basemap.nationalmap.gov" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      plausible ? (
        <script defer data-domain={plausible} src="https://plausible.io/js/script.js" />
      ) : null
    }
  </head>
  <body class="min-h-screen bg-sheet text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:border focus:border-ink focus:bg-sheet focus:px-4 focus:py-3"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
