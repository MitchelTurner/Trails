---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import VolunteerForm from "../components/VolunteerForm.tsx";
import { getCollection } from "astro:content";
import { eventDayKey, isOnOrAfterToday } from "../lib/work-parties";

const parties = (await getCollection("workParties")).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const upcoming = parties.filter(
  (item) => item.data.status === "upcoming" && isOnOrAfterToday(item.data.date),
);
const formId = import.meta.env.PUBLIC_FORMSPREE_SIGNON;
const crewEvents = upcoming.map((party) => ({ id: party.id, title: party.data.title }));

const skills = [
  {
    title: "Certified sawyers",
    note: "Current card, and the judgment to know when a leaner is somebody else's problem.",
  },
  {
    title: "People who can walk a line",
    note: "GPS, flagging, notes that somebody else can follow. Wet boots guaranteed.",
  },
  {
    title: "Somebody who writes well",
    note: "Comment letters and a clean request to a ranger district beat good intentions.",
  },
  {
    title: "Anyone with a Saturday",
    note: "Most of the work is brushing tread that already exists. No experience needed.",
  },
];
---

<BaseLayout
  title="Get involved"
  description="Youth crew, work parties, and the skills trail building actually needs."
>
  <PageHeader
    eyebrow="Get involved"
    title="Bring a saw or bring a notebook"
    lede="Signing on puts your name on the list we take to the ranger district. A work party puts your hands on tread. Students can join that crew. Neither one costs you a dollar, because we are not set up to take one."
  />

  <section id="youth" class="shell scroll-mt-24 py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Youth crew</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
          Students, come build the trail
        </h2>
        <div class="mt-6 space-y-4 leading-relaxed text-ink/85">
          <p>
            High school and college students can volunteer on construction. The work is brushing
            tread that already exists, walking a flagged line, and learning why a survey comes
            before a cut. A chainsaw stays with someone who holds a current saw card.
          </p>
          <p>
            If you are under 18, a parent or guardian signs up with you. Joining the crew does
            not enroll you in a class and does not award credit.
          </p>
          <p>
            A scholarship or an educational certificate would come from a university. None is
            available yet. Campuses that want to create one can start that conversation on the
            universities page.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/get-involved?role=student#crew-list" class="btn btn-solid">
            Add me to the crew list
          </a>
          <a href="/universities" class="btn btn-outline">For universities</a>
        </div>
      </div>
      <ul class="reveal grid content-start gap-4">
        <li class="border-t-2 border-t-ink pt-4">
          <p class="font-display text-lg font-bold tracking-tight">Who</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">
            High school students, college students, and a parent or guardian when the student is
            under 18.
          </p>
        </li>
        <li class="border-t-2 border-t-ink pt-4">
          <p class="font-display text-lg font-bold tracking-tight">What you do</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">
            Show up for a published work party. Hours count when you were there, not when you
            filled out the form.
          </p>
        </li>
        <li class="border-t-2 border-t-ink pt-4">
          <p class="font-display text-lg font-bold tracking-tight">What you do not get yet</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">
            No scholarship, no certificate, no course credit. Those exist when a campus says they
            do.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="shell border-t border-contour/60 py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="headline text-[length:var(--text-display-md)]">Work parties</h2>
      <p data-party-count class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
        {upcoming.length} on the calendar
      </p>
    </div>

    <div data-party-empty class:list={["card mt-8 p-8", upcoming.length === 0 ? "" : "hidden"]}>
      <p class="font-display text-xl font-bold tracking-tight">
        No date set yet. Get on the crew list below and we'll tell you when the next one is.
      </p>
    </div>

    <ol
      data-party-list
      class:list={["mt-10 grid gap-6 lg:grid-cols-2", upcoming.length === 0 ? "hidden" : ""]}
    >
      {
        upcoming.map((party) => (
          <li
            data-event-date={eventDayKey(party.data.date)}
            class="card card-hover reveal flex flex-col p-6 md:p-8"
          >
            <div class="flex items-start justify-between gap-4">
              <p class="eyebrow">
                {party.data.date.toLocaleDateString("en-US", {
                  weekday: "long",
                  month: "long",
                  day: "numeric",
                  timeZone: "America/Sitka",
                })}
              </p>
              <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                {party.data.date.getUTCFullYear()}
              </p>
            </div>
            <h3 class="headline mt-3 text-2xl">{party.data.title}</h3>

            <dl class="mt-6 grid gap-4 border-t border-contour/50 pt-5 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">Where</dt>
                <dd class="mt-1">{party.data.location}</dd>
              </div>
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                  Meet at
                </dt>
                <dd class="mt-1">{party.data.meetingPoint}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">Bring</dt>
                <dd class="mt-1">{party.data.whatToBring}</dd>
              </div>
            </dl>

            <a
              href={`/get-involved?event=${party.id}#crew-list`}
              class="btn btn-solid mt-auto !min-h-11 self-start !px-5 !text-sm"
            >
              Join the work party
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-contour/60 bg-sheet-raised py-16 md:py-20">
    <div class="shell">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">Skills</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
          "Likes hiking" is not a skill
        </h2>
        <p class="lede mt-5 text-ink/85">
          Everybody out here likes hiking. Here is what actually moves a trail from a line on a
          map to something you can walk.
        </p>
      </div>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          skills.map((skill) => (
            <li class="reveal border-t-2 border-t-ink pt-5">
              <p class="font-display text-lg font-bold tracking-tight">{skill.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/80">{skill.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="crew-list" class="shell scroll-mt-24 py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow">Crew list</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">Get on the list</h2>
        <p class="mt-5 leading-relaxed text-ink/85">
          This fills the next work party. It is not a mailing blast. Tell us what you can
          actually do on a wet Saturday in October, and whether you have a saw card.
        </p>
      </div>
      <div class="card p-6 md:p-8">
        <VolunteerForm client:visible formId={formId} events={crewEvents} />
      </div>
    </div>
  </section>

  <section class="shell grid gap-6 pb-16 md:grid-cols-2 md:pb-20">
    <a href="/universities" class="card reveal block p-6 md:p-8">
      <p class="eyebrow">Universities</p>
      <h2 class="headline mt-3 text-2xl md:text-3xl">Scholarships and certificates</h2>
      <p class="mt-4 leading-relaxed text-ink/85">
        Campuses that want to award either one to students on this crew can write from there.
        No campus has agreed.
      </p>
      <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
        For universities →
      </p>
    </a>
    <a href="/seatrails" class="card reveal block p-6 md:p-8">
      <p class="eyebrow">Other towns</p>
      <h2 class="headline mt-3 text-2xl md:text-3xl">If you are not in Ketchikan</h2>
      <p class="mt-4 leading-relaxed text-ink/85">
        Nineteen communities and the ferry between them built this system. This crew walks
        Revillagigedo Island. The other towns and the old resolutions are listed with the
        history.
      </p>
      <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
        The nineteen towns →
      </p>
    </a>
  </section>
</BaseLayout>

<script>
  const today = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/Sitka",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(new Date());
  const items = [...document.querySelectorAll<HTMLElement>("[data-event-date]")];
  let visible = 0;
  for (const item of items) {
    const show = (item.dataset.eventDate ?? "") >= today;
    item.hidden = !show;
    if (show) visible += 1;
  }
  const count = document.querySelector("[data-party-count]");
  if (count) count.textContent = `${visible} on the calendar`;
  const list = document.querySelector<HTMLElement>("[data-party-list]");
  const empty = document.querySelector<HTMLElement>("[data-party-empty]");
  if (list) list.hidden = visible === 0;
  if (empty) empty.hidden = visible !== 0;
</script>
