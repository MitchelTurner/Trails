---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import VolunteerForm from "../components/VolunteerForm.tsx";
import { getCollection } from "astro:content";
import { site } from "../config/site";

const parties = (await getCollection("workParties")).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const upcoming = parties.filter((item) => item.data.status === "upcoming");
const formId = import.meta.env.PUBLIC_FORMSPREE_SIGNON;

const skills = [
  { title: "Certified sawyers", note: "Current certs, and the judgment to know when not to cut." },
  { title: "Letter writers", note: "People who can put a land-manager request in plain language." },
  { title: "Data keepers", note: "Someone to keep the supporter ZIP counts honest." },
  { title: "Saturday crews", note: "Anyone willing to spend a day on tread that already exists." },
];
---

<BaseLayout
  title="Get involved"
  description="Work parties, volunteer signup, and the skills this network actually needs."
>
  <PageHeader
    eyebrow="Get involved"
    title="Show up to the work"
    lede="Signing on puts your name on the public count. A work party puts your hands on an existing mile. Both matter. Neither is a donation."
  />

  <section class="shell py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="headline text-[length:var(--text-display-md)]">Work parties</h2>
      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
        {upcoming.length} on the calendar
      </p>
    </div>

    {
      upcoming.length === 0 ? (
        <div class="card mt-8 p-8">
          <p class="font-display text-xl font-bold tracking-tight">Nothing scheduled yet.</p>
          <p class="mt-2 text-sm leading-relaxed text-ink/80">
            Email <a class="underline decoration-flagging underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a> to be on the next crew list.
          </p>
        </div>
      ) : (
        <ol class="mt-10 grid gap-6 lg:grid-cols-2">
          {upcoming.map((party) => (
            <li class="card card-hover reveal flex flex-col p-6 md:p-8">
              <div class="flex items-start justify-between gap-4">
                <p class="eyebrow">
                  {party.data.date.toLocaleDateString("en-US", {
                    weekday: "long",
                    month: "long",
                    day: "numeric",
                    timeZone: "America/Sitka",
                  })}
                </p>
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                  {party.data.date.getUTCFullYear()}
                </p>
              </div>
              <h3 class="headline mt-3 text-2xl">{party.data.title}</h3>

              <dl class="mt-6 grid gap-4 border-t border-contour/50 pt-5 text-sm sm:grid-cols-2">
                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                    Location
                  </dt>
                  <dd class="mt-1">{party.data.location}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                    Meeting point
                  </dt>
                  <dd class="mt-1">{party.data.meetingPoint}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                    What to bring
                  </dt>
                  <dd class="mt-1">{party.data.whatToBring}</dd>
                </div>
              </dl>

              <a
                href={`mailto:${party.data.contact}?subject=${encodeURIComponent(`Work party: ${party.data.title}`)}`}
                class="btn btn-solid mt-auto !min-h-11 self-start !px-5 !text-sm"
              >
                Join the work party
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="border-y border-contour/60 bg-sheet-raised py-16 md:py-20">
    <div class="shell">
      <div class="max-w-2xl reveal">
        <p class="eyebrow">Skills</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
          The useful list is not "likes hiking"
        </h2>
      </div>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          skills.map((skill) => (
            <li class="reveal border-t-2 border-t-ink pt-5">
              <p class="font-display text-lg font-bold tracking-tight">{skill.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/80">{skill.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="shell py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow">Volunteer</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">Get on the crew list</h2>
        <p class="mt-5 leading-relaxed text-ink/85">
          We use this to fill the next work party, not for a mailing blast. Tell us what you can
          actually do on a wet Saturday.
        </p>
      </div>
      <div class="card p-6 md:p-8">
        <VolunteerForm client:visible formId={formId} />
      </div>
    </div>
  </section>
</BaseLayout>
