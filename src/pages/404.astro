---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not on the network.">
  <section class="shell py-24 md:py-32">
    <p class="eyebrow">Gap</p>
    <h1 class="headline mt-4 text-[length:var(--text-display-lg)]">This page is not built.</h1>
    <p class="lede mt-6 max-w-xl text-ink/85">
      Like a few miles on the island. The map is still the center of gravity.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back to the map</a>
      <a href="/network?view=list" class="btn btn-outline">Every segment</a>
    </div>
  </section>
</BaseLayout>
