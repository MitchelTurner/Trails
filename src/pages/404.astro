---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not on the network.">
  <div class="mx-auto max-w-xl px-4 py-20">
    <p class="font-mono text-[11px] uppercase tracking-wider text-tide">Gap</p>
    <h1 class="font-display mt-2 text-4xl font-semibold tracking-tight">This page is not built.</h1>
    <p class="mt-4 leading-relaxed">
      The map is still the center of gravity.
    </p>
    <a href="/" class="mt-6 inline-block font-mono text-[12px] uppercase tracking-wider underline decoration-flagging underline-offset-4">
      Back to the network
    </a>
  </div>
</BaseLayout>
