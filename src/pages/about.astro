---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../config/site";

const audiences = [
  {
    who: "People who already go out",
    need: "Where the tread goes, where it stops, and what is actually walkable in October.",
    act: "Sign on. Come out on a work party.",
  },
  {
    who: "The outfits that own the ground",
    need: "A route drawn honestly, with the ownership named and the process respected.",
    act: "Take a meeting.",
  },
  {
    who: "Whoever funds trail work",
    need: "A project with a surveyed line, a study, and a materials list — not a feeling.",
    act: "Fund a segment.",
  },
];

const partners = [
  "Tongass National Forest",
  "Ketchikan–Misty Fjords Ranger District",
  "Alaska State Parks",
  "Alaska Mental Health Trust",
  "Ketchikan Gateway Borough",
  "City of Ketchikan",
  "City of Saxman",
  "Native corporations with surface estate",
];
---

<BaseLayout
  title="About"
  description="An informal group working on walking routes across Revillagigedo Island, starting with the Naha cabins."
>
  <PageHeader
    eyebrow="About"
    title={site.name}
    lede={`Working name for the ${site.orgName} — a few residents who would rather walk to the cabins than wait on a floatplane. There is no entity and no 501(c)(3) behind it, which is exactly why this site does not ask you for money.`}
  />

  <section class="shell py-16 md:py-20">
    <h2 class="headline text-[length:var(--text-display-md)]">Who this is for</h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        audiences.map((item) => (
          <div class="card reveal p-6">
            <p class="font-display text-xl font-bold tracking-tight">{item.who}</p>
            <p class="mt-4 text-sm leading-relaxed text-ink/85">{item.need}</p>
            <p class="mt-4 font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-flagging-deep">
              {item.act}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-contour/60 bg-sheet-raised py-16 md:py-20">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">Who owns the ground</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
          Nobody on this list has signed off on anything
        </h2>
        <p class="mt-5 leading-relaxed text-ink/85">
          These are the outfits that hold ground on Revilla. Naming them says who has to be in
          the room. It does not mean any of them have blessed a line on our map, and we are not
          going to imply otherwise.
        </p>
        <p class="mt-4 leading-relaxed text-ink/85">
          The first project sits on Tongass ground, so the Ketchikan–Misty Fjords Ranger District
          is the door we knock on first.
        </p>
      </div>
      <ul class="flex flex-wrap content-start gap-2">
        {partners.map((partner) => <li class="chip">{partner}</li>)}
      </ul>
    </div>
  </section>

  <section class="shell grid gap-12 py-16 lg:grid-cols-2 lg:gap-16 md:py-20">
    <div>
      <h2 class="headline text-[length:var(--text-display-md)]">Who is doing this</h2>
      <p class="mt-5 leading-relaxed text-ink/85">
        Names go here when the group decides to put them on a public page. Until then, write to
        us — someone reads it.
      </p>
      <a href={`mailto:${site.email}`} class="btn btn-outline mt-8">{site.email}</a>
    </div>
    <div>
      <h2 class="headline text-[length:var(--text-display-md)]">Where the paperwork stands</h2>
      <p class="mt-5 leading-relaxed text-ink/85">
        Nothing is incorporated. None of this is legal advice, and the group should get some
        before it takes a dollar. The two normal roads are incorporating as an Alaska nonprofit
        with DCCED and filing IRS Form 1023-EZ, or working under a fiscal sponsor — Alaska Trails
        or a community foundation — in the meantime.
      </p>
    </div>
  </section>
</BaseLayout>
