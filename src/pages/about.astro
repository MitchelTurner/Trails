---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../config/site";

const audiences = [
  {
    who: "Residents",
    need: "Trails they already use, plus the gaps between them.",
    act: "Sign on, show up to a work party.",
  },
  {
    who: "Land managers",
    need: "A coherent, honest network plan that spans jurisdictions.",
    act: "Take a meeting.",
  },
  {
    who: "Future funders",
    need: "A credible, mapped project pipeline.",
    act: "Fund a segment.",
  },
];

const partners = [
  "Tongass National Forest",
  "Alaska State Parks",
  "Alaska Mental Health Trust",
  "Ketchikan Gateway Borough",
  "City of Ketchikan",
  "City of Saxman",
  "Native corporations with surface estate",
];
---

<BaseLayout
  title="About"
  description="An informal association working to connect Revillagigedo Island's trails across jurisdictions."
>
  <PageHeader
    eyebrow="About"
    title={site.name}
    lede={`Working name for the ${site.orgName} — an informal group of residents who want the island's trails to function as a network. There is no entity and no 501(c)(3). That is why this site does not ask for money.`}
  />

  <section class="shell py-16 md:py-20">
    <h2 class="headline text-[length:var(--text-display-md)]">Who this is for</h2>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        audiences.map((item) => (
          <div class="card reveal p-6">
            <p class="font-display text-xl font-bold tracking-tight">{item.who}</p>
            <p class="mt-4 text-sm leading-relaxed text-ink/85">{item.need}</p>
            <p class="mt-4 font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-flagging-deep">
              {item.act}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-y border-contour/60 bg-sheet-raised py-16 md:py-20">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow">Partners we have to talk to</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
          Nobody on this list has endorsed the map
        </h2>
        <p class="mt-5 leading-relaxed text-ink/85">
          These are the entities that hold ground on Revilla. Listing them is a statement of who has
          to be in the room, not a claim of support.
        </p>
      </div>
      <ul class="flex flex-wrap content-start gap-2">
        {partners.map((partner) => <li class="chip">{partner}</li>)}
      </ul>
    </div>
  </section>

  <section class="shell grid gap-12 py-16 lg:grid-cols-2 lg:gap-16 md:py-20">
    <div>
      <h2 class="headline text-[length:var(--text-display-md)]">Board</h2>
      <p class="mt-5 leading-relaxed text-ink/85">
        Names go here when the group is ready to put them on a public page. Until then, write us.
      </p>
      <a href={`mailto:${site.email}`} class="btn btn-outline mt-8">{site.email}</a>
    </div>
    <div>
      <h2 class="headline text-[length:var(--text-display-md)]">Legal posture</h2>
      <p class="mt-5 leading-relaxed text-ink/85">
        This is not legal advice, and the group should get some before taking a dollar. The two
        ordinary paths are incorporating as an Alaska nonprofit with DCCED and filing IRS Form
        1023-EZ, or operating under a fiscal sponsor — Alaska Trails or a community foundation — and
        taking donations through them in the meantime.
      </p>
    </div>
  </section>
</BaseLayout>
