---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ReportForm from "../components/ReportForm.tsx";

const formId = import.meta.env.PUBLIC_FORMSPREE_REPORT;
---

<BaseLayout
  title="Report an issue"
  description="Tell us what you found out there. Right now this is a mailbox, not a work queue."
>
  <PageHeader
    eyebrow="Report"
    title="Tell us what you found"
    lede="Blowdown across the tread, boardwalk gone soft, a washed-out crossing, a stretch that has quietly become dangerous."
  />

  <section class="shell grid gap-10 py-16 lg:grid-cols-[1fr_1.1fr] lg:gap-16 md:py-20">
    <div>
      <p class="eyebrow">Straight answer about what this does</p>
      <ul class="mt-5 space-y-4 text-sm leading-relaxed text-ink/85">
        <li class="border-l-2 border-l-contour pl-4">
          It sends an email to us. It does not change anything on the public map.
        </li>
        <li class="border-l-2 border-l-contour pl-4">
          Photos, a map pin, and a queue you can actually watch come once there is an entity with
          somewhere to put files.
        </li>
        <li class="border-l-2 border-l-flagging pl-4">
          If it is dangerous or urgent, call the outfit that manages that ground. On Tongass
          trails that is the Ketchikan–Misty Fjords Ranger District, not us.
        </li>
      </ul>
    </div>
    <div class="card p-6 md:p-8">
      <ReportForm client:visible formId={formId} />
    </div>
  </section>
</BaseLayout>
