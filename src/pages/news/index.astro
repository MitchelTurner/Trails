---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [lead, ...rest] = posts;
---

<BaseLayout title="News" description="Notes from the work of connecting Revilla's trails.">
  <PageHeader eyebrow="News" title="Notes from the work">
    <a href="/rss.xml" class="btn btn-outline mt-8 !min-h-11 !px-5 !text-sm">Subscribe by RSS</a>
  </PageHeader>

  <section class="shell py-16 md:py-20">
    {
      lead ? (
        <a href={`/news/${lead.id}`} class="card card-hover reveal block p-8 md:p-12">
          <p class="eyebrow">
            Latest ·{" "}
            {lead.data.date.toLocaleDateString("en-US", {
              month: "long",
              day: "numeric",
              year: "numeric",
              timeZone: "America/Sitka",
            })}
          </p>
          <h2 class="headline mt-4 max-w-3xl text-[length:var(--text-display-md)]">
            {lead.data.title}
          </h2>
          <p class="lede mt-5 max-w-2xl text-ink/85">{lead.data.excerpt}</p>
          <span class="mt-8 inline-block font-mono text-[10px] uppercase tracking-[0.14em] text-ink underline decoration-flagging underline-offset-4">
            Read it
          </span>
        </a>
      ) : null
    }

    {
      rest.length ? (
        <ol class="mt-8 grid gap-6 md:grid-cols-2">
          {rest.map((post) => (
            <li>
              <a href={`/news/${post.id}`} class="card card-hover reveal flex h-full flex-col p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
                  {post.data.date.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                    timeZone: "America/Sitka",
                  })}
                </p>
                <h3 class="headline mt-3 text-xl">{post.data.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink/80">{post.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ol>
      ) : null
    }
  </section>
</BaseLayout>
