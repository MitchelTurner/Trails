---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="News" description="Notes from the work of connecting Revilla's trails.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-tide">News</p>
    <h1 class="font-display mt-2 text-4xl font-semibold tracking-tight">Notes from the work</h1>
    <ol class="mt-8 grid gap-6">
      {
        posts.map((post) => (
          <li class="border-b border-contour/70 pb-6">
            <p class="font-mono text-[11px] uppercase tracking-wider text-tide">
              {post.data.date.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                timeZone: "America/Sitka",
              })}
            </p>
            <h2 class="font-display mt-1 text-2xl font-semibold">
              <a href={`/news/${post.id}`} class="hover:text-tide">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink/85">{post.data.excerpt}</p>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
