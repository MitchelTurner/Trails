---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GapLine, partsFromCorridor, partsFromSegments } from "../components/GapLine.tsx";
import { getSegments, loadCorridors, networkTotals } from "../lib/network";

const segments = getSegments();
const corridors = loadCorridors();
const totals = networkTotals(segments);
---

<BaseLayout
  title="Vision"
  description="The plan: a short list of corridors, honest land ownership, and what the gaps actually need."
  gapLine
>
  <div slot="gapline" class="border-b border-transparent bg-sheet px-4 pt-3">
    <div class="mx-auto max-w-6xl">
      <GapLine
        client:load
        parts={partsFromSegments(segments)}
        builtMi={totals.existingMi}
        gapMi={totals.gapMi}
        animate
      />
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 py-12">
    <p class="font-mono text-[11px] uppercase tracking-wider text-tide">The plan</p>
    <h1 class="font-display mt-2 text-4xl font-semibold tracking-tight">Connect the island</h1>
    <p class="mt-5 text-lg leading-relaxed">
      This is connective public infrastructure, not a hiking club. The artifact is a status-coded
      map of every existing and proposed segment on Revilla, with land ownership attached. A short
      list of corridors the group can stand behind beats an exhaustive one nobody agreed to.
    </p>

    <h2 class="font-display mt-12 text-2xl font-semibold">Land ownership is the work</h2>
    <p class="mt-4 leading-relaxed">
      A segment that looks like one line on a topo sheet can cross Forest Service, State, Mental
      Health Trust, Borough, City, and Native corporation land. That is not a footnote. It is why
      the network has not been connected, and why every segment page leads with land-manager chips.
    </p>
    <p class="mt-4 leading-relaxed">
      Ownership on this site is intersected at build time from public layers: USFS Basic Ownership,
      Alaska DNR Mental Health Trust and municipal entitlement, and Ketchikan Gateway Borough tax
      parcels. It is a planning picture, not a title search.
    </p>

    <h2 class="font-display mt-12 text-2xl font-semibold">What pink means</h2>
    <p class="mt-4 leading-relaxed">
      Pink is surveyor's flagging. On this site it appears only on gaps — proposed segments and the
      sign-on button. Every proposed line says it is a conceptual alignment and is not surveyed.
      Treating an unsurveyed line as engineered is how a new group loses a Forest Service meeting.
    </p>
  </div>

  <section class="mx-auto max-w-6xl px-4 pb-4">
    <h2 class="font-display text-2xl font-semibold">Featured project</h2>
    <a
      href="/projects/naha-connector"
      class="mt-6 block border border-flagging/70 bg-flagging/5 p-5 transition hover:bg-flagging/10"
    >
      <p class="font-mono text-[11px] uppercase tracking-wider text-tide">
        Shelter Cove → Loring
      </p>
      <h3 class="font-display mt-1 text-xl font-semibold">The Naha Connector</h3>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed">
        The State opened Shelter Cove Road in October 2025, then stopped at the edge of a
        roadless area written to accommodate recreation access. Two trail segments would
        complete the first walk-in route from Ketchikan's road system to the Naha's cabins and
        the National Recreation Trail down to Loring.
      </p>
      <p class="mt-3 font-mono text-[12px] uppercase tracking-wider underline decoration-flagging underline-offset-4">
        Read the project →
      </p>
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="font-display text-2xl font-semibold">Priority corridors</h2>
    <div class="mt-6 grid gap-8">
      {corridors.map((corridor) => (
        <article id={corridor.id} class="scroll-mt-8 border border-contour/70 p-5">
          <h3 class="font-display text-xl font-semibold">{corridor.name}</h3>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed">{corridor.blurb}</p>
          <GapLine
            client:visible
            parts={partsFromCorridor(corridor, segments)}
            builtMi={corridor.existingMi}
            gapMi={corridor.gapMi}
            animate={false}
            quiet
            className="mt-5"
          />
          <p class="mt-3 font-mono text-[12px] uppercase tracking-wider">
            {corridor.existingMi.toFixed(1)} of {corridor.totalMi.toFixed(1)} miles connected ·{" "}
            {corridor.percentComplete.toFixed(0)}%
          </p>
          <a
            href={`/network?corridor=${corridor.id}`}
            class="mt-3 inline-block font-mono text-[12px] uppercase tracking-wider underline decoration-contour underline-offset-4"
          >
            Open in the network map
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
