---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import NetworkExplorer from "../../components/NetworkExplorer.tsx";
import {
  getSegments,
  loadCorridors,
  namedLandManagers,
  networkTotals,
  uniqueLandManagers,
} from "../../lib/network";

const segments = getSegments();
const corridors = loadCorridors();
// Filters keep the "Unmapped" sentinel so those segments stay findable.
const landManagers = uniqueLandManagers(segments);
const namedManagers = namedLandManagers(segments);
const totals = networkTotals(segments);
const view = Astro.url.searchParams.get("view") === "list" ? "list" : "map";
const corridor = Astro.url.searchParams.get("corridor");
---

<BaseLayout
  title="Network"
  description="Every existing and proposed trail segment on Revillagigedo Island, with land managers attached."
>
  <PageHeader
    eyebrow="The network"
    title={`${segments.length} segments on Revilla`}
    lede="Status is in the line, not just the color: solid ink is usable, faded ink needs work, muskeg dashes are under construction, pink dashes do not exist yet."
  >
    <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/70">Built</dt>
        <dd class="font-display text-2xl font-bold">{totals.existingMi.toFixed(1)} mi</dd>
      </div>
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/70">Gap</dt>
        <dd class="font-display text-2xl font-bold text-flagging">{totals.gapMi.toFixed(1)} mi</dd>
      </div>
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/70">
          Land managers
        </dt>
        <dd class="font-display text-2xl font-bold">{namedManagers.length}</dd>
      </div>
    </dl>
    <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/60">
      Tab cycles segments · Enter selects · Esc clears
    </p>
  </PageHeader>

  <div class="shell py-10 md:py-14">
    <NetworkExplorer
      client:load
      segments={segments}
      corridors={corridors}
      landManagers={landManagers}
      initialView={view}
      initialCorridor={corridor}
    />
  </div>
</BaseLayout>
