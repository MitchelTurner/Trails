---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrailMap from "../../components/TrailMap.tsx";
import { StatusChip } from "../../components/StatusChip.tsx";
import { loadNetwork, loadCorridors, getCorridorById } from "../../lib/network";
import { formatElevation, formatMiles, formatSurface, isConceptual } from "../../lib/format";

export function getStaticPaths() {
  return loadNetwork().features.map((feature) => ({
    params: { segmentId: feature.properties.id },
    props: { feature },
  }));
}

const { feature } = Astro.props;
const segment = feature.properties;
const corridors = loadCorridors();
const corridor = segment.corridorId ? getCorridorById(segment.corridorId) : undefined;
---

<BaseLayout
  title={segment.name}
  description={segment.summary}
  canonical={`/network/${segment.id}`}
>
  <article class="mx-auto max-w-6xl px-4 py-8">
    <p class="font-mono text-[11px] uppercase tracking-wider text-tide">
      <a href="/network" class="hover:text-ink">Network</a>
      {corridor ? (
        <>
          <span aria-hidden> / </span>
          <a href={`/vision#${corridor.id}`} class="hover:text-ink">{corridor.name}</a>
        </>
      ) : null}
    </p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <h1 class="font-display text-4xl font-semibold tracking-tight">{segment.name}</h1>
      <StatusChip status={segment.status} />
    </div>

    {isConceptual(segment.sourceRef) ? (
      <p class="mt-5 border border-flagging bg-flagging/10 px-4 py-3 text-sm">
        Conceptual alignment only — not surveyed. Showing an unsurveyed line as if it were
        engineered is how a new group loses credibility with the Forest Service in one meeting.
      </p>
    ) : null}

    <dl class="mt-6 grid gap-4 border-y border-contour/70 py-5 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-tide">Length</dt>
        <dd class="mt-1 font-mono text-sm">{formatMiles(segment.lengthMi)}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-tide">Elevation gain</dt>
        <dd class="mt-1 font-mono text-sm">{formatElevation(segment.elevationGainFt)}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-tide">Surface</dt>
        <dd class="mt-1 font-mono text-sm">{formatSurface(segment.surface)}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-wider text-tide">Season</dt>
        <dd class="mt-1 font-mono text-sm">{segment.seasonality ?? "—"}</dd>
      </div>
    </dl>

    <div class="mt-6">
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-tide">Land managers</h2>
      <ul class="mt-2 flex flex-wrap gap-2">
        {segment.landManagers.map((manager) => (
          <li class="border border-tide/30 bg-tide/5 px-2 py-1 font-mono text-[11px] uppercase tracking-wider text-tide">
            {manager}
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-6 max-w-3xl text-base leading-relaxed">{segment.summary}</p>

    {segment.status !== "existing" && segment.whatItNeeds ? (
      <section class="mt-6 max-w-3xl">
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-tide">What it needs</h2>
        <p class="mt-2 leading-relaxed">{segment.whatItNeeds}</p>
      </section>
    ) : null}

    <p class="mt-4 font-mono text-[11px] uppercase tracking-wider text-tide">
      Source {segment.sourceRef} · updated {segment.updatedAt}
    </p>

    <div class="mt-8 h-[min(60vh,36rem)] border border-contour/70">
      <TrailMap client:load urlSync initialSegmentId={segment.id} corridors={corridors} />
    </div>

    {segment.connectsTo.length ? (
      <section class="mt-8">
        <h2 class="font-mono text-[11px] uppercase tracking-wider text-tide">Connects to</h2>
        <ul class="mt-3 flex flex-wrap gap-3">
          {segment.connectsTo.map((id) => (
            <li>
              <a href={`/network/${id}`} class="font-mono text-[12px] uppercase tracking-wider underline decoration-contour underline-offset-4 hover:text-tide">
                {id}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </article>
</BaseLayout>
