---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrailMap from "../../components/TrailMap.tsx";
import { StatusChip } from "../../components/StatusChip.tsx";
import { loadNetwork, loadCorridors, getCorridorById, getSegmentById } from "../../lib/network";
import { formatElevation, formatMiles, formatSurface, isConceptual } from "../../lib/format";

export function getStaticPaths() {
  return loadNetwork().features.map((feature) => ({
    params: { segmentId: feature.properties.id },
    props: { feature },
  }));
}

const { feature } = Astro.props;
const segment = feature.properties;
const corridors = loadCorridors();
const corridor = segment.corridorId ? getCorridorById(segment.corridorId) : undefined;
const conceptual = isConceptual(segment.sourceRef);

const difficulty = segment.difficulty
  ? segment.difficulty[0].toUpperCase() + segment.difficulty.slice(1)
  : "—";

const facts = [
  { label: "Length", value: formatMiles(segment.lengthMi) },
  { label: "Elevation gain", value: formatElevation(segment.elevationGainFt) },
  { label: "Surface", value: formatSurface(segment.surface) },
  { label: "Difficulty", value: difficulty },
  { label: "Season", value: segment.seasonality ?? "—" },
];

const neighbors = segment.connectsTo
  .map((id) => getSegmentById(id)?.properties)
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<BaseLayout title={segment.name} description={segment.summary} canonical={`/network/${segment.id}`}>
  <article>
    <section class="on-dark bg-ink text-sheet">
      <div class="shell py-12 md:py-16">
        <nav aria-label="Breadcrumb" class="font-mono text-[10px] uppercase tracking-[0.14em]">
          <a href="/network" class="text-sheet/70 underline decoration-sheet/30 underline-offset-4 hover:text-sheet">
            Network
          </a>
          {
            corridor ? (
              <>
                <span aria-hidden class="px-2 text-sheet/40">/</span>
                <a
                  href={`/vision#${corridor.id}`}
                  class="text-sheet/70 underline decoration-sheet/30 underline-offset-4 hover:text-sheet"
                >
                  {corridor.name}
                </a>
              </>
            ) : null
          }
        </nav>

        <div class="mt-5 flex flex-wrap items-center gap-4">
          <StatusChip status={segment.status} />
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/70">
            {formatMiles(segment.lengthMi)}
          </span>
        </div>

        <h1 class="headline mt-4 text-[length:var(--text-display-lg)]">{segment.name}</h1>
        <p class="lede mt-5 max-w-2xl text-sheet/85">{segment.summary}</p>

        <dl class="mt-10 grid gap-6 border-t border-sheet/15 pt-8 sm:grid-cols-3 lg:grid-cols-5">
          {
            facts.map((fact) => (
              <div>
                <dt class="font-mono text-[10px] uppercase tracking-[0.14em] text-sheet/60">
                  {fact.label}
                </dt>
                <dd class="mt-2 font-display text-lg font-bold tracking-tight">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {
      conceptual ? (
        <section class="border-b-2 border-flagging bg-flagging/12">
          <div class="shell flex flex-col gap-2 py-6 md:flex-row md:items-center md:gap-6">
            <p class="font-display shrink-0 text-base font-bold tracking-tight text-ink">
              Conceptual alignment only — not surveyed.
            </p>
            <p class="text-sm leading-relaxed text-ink/85">
              Showing an unsurveyed line as if it were engineered is how a new group loses
              credibility with the Forest Service in one meeting.
            </p>
          </div>
        </section>
      ) : null
    }

    <div class="shell grid gap-12 py-14 lg:grid-cols-[1.6fr_1fr] lg:gap-16">
      <div>
        <div class="h-[min(60vh,34rem)] border border-contour/70">
          <TrailMap
            client:load
            urlSync
            showLegend={false}
            openPanelForInitial={false}
            initialSegmentId={segment.id}
            corridors={corridors}
          />
        </div>

        {
          neighbors.length ? (
            <section class="mt-12">
              <h2 class="eyebrow">Connects to</h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {neighbors.map((item) => (
                  <li>
                    <a href={`/network/${item.id}`} class="card card-hover flex flex-col gap-1 p-4">
                      <span class="font-display text-sm font-bold tracking-tight">{item.name}</span>
                      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-tide">
                        {item.status} · {formatMiles(item.lengthMi)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="card p-6">
          <h2 class="eyebrow">Land managers</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {segment.landManagers.map((manager) => <li class="chip">{manager}</li>)}
          </ul>
          <p class="mt-5 text-xs leading-relaxed text-ink/70">
            Intersected from public ownership layers at build time. A planning picture, not a title
            search.
          </p>
        </div>

        {
          segment.status !== "existing" && segment.whatItNeeds ? (
            <div class="card mt-6 border-l-2 border-l-flagging p-6">
              <h2 class="eyebrow">What it needs</h2>
              <p class="mt-3 leading-relaxed">{segment.whatItNeeds}</p>
            </div>
          ) : null
        }

        {
          corridor ? (
            <a href={`/vision#${corridor.id}`} class="card card-hover mt-6 block p-6">
              <p class="eyebrow">Corridor</p>
              <p class="font-display mt-2 text-lg font-bold tracking-tight">{corridor.name}</p>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.12em] text-tide">
                {corridor.existingMi.toFixed(1)} of {corridor.totalMi.toFixed(1)} mi connected
              </p>
            </a>
          ) : null
        }

        <p class="mt-6 font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-tide">
          Source {segment.sourceRef} · updated {segment.updatedAt}
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>
