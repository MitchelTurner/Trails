---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CorridorCard } from "../components/CorridorCard.tsx";
import SignOnForm from "../components/SignOnForm.tsx";
import StatBand from "../components/StatBand.astro";
import FeatureBlock from "../components/FeatureBlock.astro";
import { site } from "../config/site";
import {
  getSegments,
  loadCorridors,
  loadSupporters,
  namedLandManagers,
  networkTotals,
} from "../lib/network";
import { getCollection } from "astro:content";

const segments = getSegments();
const corridors = loadCorridors();
const totals = networkTotals(segments);
const supporters = loadSupporters();
const managers = namedLandManagers(segments);
const formId = import.meta.env.PUBLIC_FORMSPREE_SIGNON;

const lead = corridors[0];
const rest = corridors.slice(1);

const posts = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero: quad-sheet paper, a headline, and the pitch. No map. -->
  <section
    class="relative isolate border-b border-contour/60"
    style="background-image:url('/topo-bg.svg');background-size:cover;background-position:center;"
  >
    <div class="shell py-24 md:py-36">
      <p class="eyebrow">Southeast Alaska</p>
      <h1 class="headline mt-5 max-w-4xl text-[length:var(--text-display-xl)]">
        {site.tagline}
      </h1>
      <p class="lede mt-7 max-w-2xl text-ink/85">
        Southeast communities built SEAtrails so a person could step off the ferry and walk a
        trail their town had already chosen. The organization went quiet. This is the site for
        starting it again. The first map is Revillagigedo Island. Students can join the crew
        that builds the gaps. Universities can put a scholarship or a certificate on that work.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#sign-on" class="btn btn-primary">Sign on</a>
        <a href="/network" class="btn btn-outline">Open the map</a>
        <a href="/get-involved#youth" class="btn btn-outline">Join the youth crew</a>
      </div>
    </div>
  </section>

  <StatBand
    dark
    stats={[
      { value: totals.existingMi.toFixed(0), label: "Miles you can walk today" },
      { value: totals.gapMi.toFixed(0), label: "Miles still to cut", accent: true },
      { value: String(totals.count), label: "Segments mapped" },
      { value: String(managers.length), label: "Outfits that own the ground" },
    ]}
  />

  <section class="border-b border-contour/60">
    <div class="shell py-16 md:py-20">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Start here</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">Three ways in</h2>
      </div>
      <ul class="mt-10 grid gap-6 lg:grid-cols-3">
        <li class="card reveal flex flex-col p-6">
          <p class="eyebrow">Youth</p>
          <h3 class="headline mt-3 text-2xl">Come build trail</h3>
          <p class="mt-4 text-sm leading-relaxed text-ink/85">
            High school and college students can volunteer on the crew: brushing tread, walking
            a flagged line, and learning the work that comes before a cut. Under 18, a parent or
            guardian signs up with you.
          </p>
          <a href="/get-involved#youth" class="btn btn-outline mt-6 self-start">Join the youth crew</a>
        </li>
        <li class="card reveal flex flex-col p-6">
          <p class="eyebrow">Universities</p>
          <h3 class="headline mt-3 text-2xl">Scholarships and certificates</h3>
          <p class="mt-4 text-sm leading-relaxed text-ink/85">
            We are asking campuses to award a scholarship or an educational certificate to
            students who do that work. No campus has agreed. The money, if a campus offers it,
            goes to the student. This group cannot take it.
          </p>
          <a href="/universities" class="btn btn-outline mt-6 self-start">For universities</a>
        </li>
        <li class="card reveal flex flex-col p-6">
          <p class="eyebrow">The organization</p>
          <h3 class="headline mt-3 text-2xl">Who is publishing this</h3>
          <p class="mt-4 text-sm leading-relaxed text-ink/85">
            SEAtrails, as an informal group. No corporation, no 501(c)(3), no donate button.
            The email, the archive, and where the paperwork stands are on one page.
          </p>
          <a href="/about" class="btn btn-outline mt-6 self-start">Organizational info</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- The first project leads the page. -->
  {
    lead ? (
      <section class="shell py-16 md:py-24">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
          <div class="reveal">
            <p class="eyebrow">First project</p>
            <h2 class="headline mt-4 text-[length:var(--text-display-lg)]">{lead.name}</h2>
            <p class="lede mt-6 text-ink/85">{lead.blurb}</p>
            <p class="mt-6 leading-relaxed text-ink/85">
              Right now that route only exists as flagging and a track on a handheld. Before
              anything gets cut it needs a finished survey and an environmental study with the
              Ketchikan–Misty Fjords Ranger District. After that it is brushing, puncheon
              through the wet ground, and tent platforms where a person would want to stop.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`/network?corridor=${lead.id}`} class="btn btn-outline">
                Walk it on the map
              </a>
              <a href="/get-involved" class="btn btn-outline">Help cut it</a>
            </div>
          </div>
          <div class="reveal">
            <CorridorCard client:visible corridor={lead} segments={segments} />
          </div>
        </div>
      </section>
    ) : null
  }

  <!-- Sign on, second content section. The id is what header and footer links use. -->
  <section id="sign-on" class="on-dark scroll-mt-20 bg-ink py-16 text-sheet md:py-24">
    <div class="shell grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="reveal">
        <p class="eyebrow">Sign on</p>
        {
          supporters.count == null ? (
            <>
              <h2 class="headline mt-4 text-[length:var(--text-display-lg)]">
                Put your name behind it.
              </h2>
              <p class="mt-6 max-w-md leading-relaxed text-sheet/80">
                We are not asking for money. There is no entity to hold it and nothing here is
                tax-deductible. What moves a ranger district and an assembly is a list of
                residents who want the route, so that is what we are building. We will publish
                the count when there is a real one to publish.
              </p>
            </>
          ) : (
            <>
              <p class="headline mt-4 text-[length:var(--text-display-lg)] text-flagging">
                {supporters.count.toLocaleString("en-US")}
              </p>
              <h2 class="headline mt-2 text-[length:var(--text-display-md)]">
                people have put their name behind connecting the island.
              </h2>
              <p class="mt-6 max-w-md leading-relaxed text-sheet/80">
                We are not asking for money. There is no entity to hold it and nothing here is
                tax-deductible. A list of residents is what moves a ranger district and an
                assembly.
              </p>
            </>
          )
        }
        <p class="mt-4 font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-sheet/60">
          Not a donation · Not tax-deductible · {totals.gapMi.toFixed(0)} miles still uncut
        </p>
      </div>
      <div class="reveal">
        <SignOnForm client:visible count={supporters.count} formId={formId} />
      </div>
    </div>
  </section>

  <FeatureBlock
    flip
    eyebrow="The hard part"
    title="A mile of trail can cross four landlords"
    body="Out here the tape measure is the easy instrument. One line on a quad sheet can leave Forest Service ground, cross State selections, clip a Mental Health Trust parcel, and finish on Borough land. That is the reason the island was never stitched together, so every segment page leads with who you have to ask."
    href="/vision"
    cta="The plan"
  >
    <div class="card p-6">
      <p class="eyebrow">Who owns the ground</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {managers.map((manager) => <li class="chip">{manager}</li>)}
      </ul>
      <p class="mt-6 text-sm leading-relaxed text-ink/75">
        Pulled from public ownership layers when the map is built. Good enough to know whose
        door to knock on. Not a title search.
      </p>
    </div>
  </FeatureBlock>

  <!-- Remaining corridors -->
  {
    rest.length ? (
      <section class="border-t border-contour/60 bg-sheet-raised py-16 md:py-24">
        <div class="shell">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">After that</p>
            <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
              The rest of the list, in order
            </h2>
            <p class="lede mt-5 text-ink/85">
              A corridor is a named route made of segments you can point at. Short list on
              purpose — a plan the board will actually stand behind beats a wish list nobody
              signed.
            </p>
          </div>
          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {rest.map((corridor) => (
              <div class="reveal h-full">
                <CorridorCard client:visible compact corridor={corridor} segments={segments} />
              </div>
            ))}
          </div>
          <a
            href="/vision"
            class="mt-8 inline-flex min-h-11 items-center font-mono text-[11px] uppercase tracking-[0.14em] text-ink underline decoration-contour underline-offset-4 hover:decoration-ink"
          >
            All four routes, segment by segment →
          </a>
        </div>
      </section>
    ) : null
  }

  <section class="shell py-16 md:py-24">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">The towns</p>
      <h2 class="headline mt-4 text-[length:var(--text-display-md)]">
        Nineteen communities built this once.
      </h2>
      <p class="lede mt-5 text-ink/85">
        Each town nominated its own trails, and the ferry tied them together. Those resolutions
        are history. This site is where the revival is being published. The map we can defend
        today is Ketchikan, because that is the ground this group walks. A town gets a page
        when people who live there are doing the work.
      </p>
      <a href="/seatrails" class="btn btn-outline mt-8">The nineteen towns</a>
    </div>
  </section>

  <!-- The latest -->
  <section class="shell py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="reveal">
        <p class="eyebrow">From the field</p>
        <h2 class="headline mt-4 text-[length:var(--text-display-md)]">Notes off the trail</h2>
      </div>
      <a href="/news" class="btn btn-outline !min-h-11 !px-5 !text-sm">All posts</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        posts.map((post) => (
          <a href={`/news/${post.id}`} class="card card-hover reveal flex flex-col p-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-tide">
              {post.data.date.toLocaleDateString("en-US", {
                month: "long",
                day: "numeric",
                year: "numeric",
                timeZone: "America/Sitka",
              })}
            </p>
            <h3 class="headline mt-3 text-xl">{post.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/80">{post.data.excerpt}</p>
            <span class="mt-auto pt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-ink underline decoration-flagging underline-offset-4">
              Read it
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
