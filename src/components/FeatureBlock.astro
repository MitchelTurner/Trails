---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  href?: string;
  cta?: string;
  flip?: boolean;
}

const { eyebrow, title, body, href, cta, flip = false } = Astro.props;
---

<section class="shell py-16 md:py-24">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div class:list={["reveal", flip ? "lg:order-2" : ""]}>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="headline mt-4 text-[length:var(--text-display-md)]">{title}</h2>
      <p class="lede mt-5 max-w-xl text-ink/85">{body}</p>
      {
        href && cta ? (
          <a href={href} class="btn btn-outline mt-8">
            {cta}
          </a>
        ) : null
      }
    </div>
    <div class:list={["reveal", flip ? "lg:order-1" : ""]}>
      <slot />
    </div>
  </div>
</section>
